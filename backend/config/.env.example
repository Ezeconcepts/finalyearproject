# Copy this file to config/.env and fill in your values

MONGO_URI=mongodb://mongo:27017/forteFile
PORT=3001

# Generate these with: openssl rand -hex 32 / openssl rand -hex 16
CRYPTOKEY=your_32_byte_hex_key_here
IV=your_16_byte_hex_iv_here

# Server master key that encrypts each user's ECC private key at rest
MASTER_KEY=your_32_byte_hex_master_key_here

# Dropbox — get these from https://www.dropbox.com/developers/apps
# Run: node config/get-dropbox-token.js  to generate the refresh token
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
